# Both variables are optional. Leave them unset to use the same-origin /api path
# (the Vite proxy in dev, the vercel.json rewrite in production) — that is the
# recommended setup, because the session cookie then stays first-party.

# Dev only: where the Vite dev server forwards /api. Defaults to localhost:4000.
# VITE_API_PROXY_TARGET=http://localhost:4000

# Build time: set ONLY if the frontend should call the backend cross-origin
# instead of going through the /api rewrite. Requires COOKIE_SAMESITE=none and a
# matching CORS_ORIGIN on the backend, and Safari will block the cookie.
# VITE_API_BASE_URL=https://your-backend.up.railway.app
